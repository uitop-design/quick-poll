{
  "name": "quick-poll",
  "version": "1.0.0",
  "description": "Quick polls API with voting and live results",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:cov": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
    "db:migrate": "tsx --env-file-if-exists=.env src/database/cli/migrate.ts",
    "db:rollback": "tsx --env-file-if-exists=.env src/database/cli/rollback.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/database/cli/seed.ts",
    "db:migrate:prod": "node dist/database/cli/migrate.js",
    "db:seed:prod": "node dist/database/cli/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/platform-socket.io": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/websockets": "12.4.2",
    "ioredis": "6.0.0",
    "knex": "3.3.0",
    "nestjs-zod": "5.6.0",
    "objection": "4.4.3",
    "pg": "8.23.1",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "jest": "30.5.2",
    "oxlint": "1.93.0",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "nestjs-zod": {
      "@nestjs/common": "$@nestjs/common",
      "@nestjs/swagger": "$@nestjs/swagger"
    }
  }
}
